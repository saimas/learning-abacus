{
  "expo": {
    "name": "Learning Abacus",
    "slug": "learning-abacus",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "learningabacus",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF5F2",
    "ios": {
      "icon": "./assets/app.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.saimas.learningabacus",
      "buildNumber": "41",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "まいにち5分！そろばん練習",
        "CFBundleLocalizations": [
          "ja",
          "en"
        ]
      }
    },
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
